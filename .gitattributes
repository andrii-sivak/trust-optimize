# The release archive (git archive) contains only the paths listed below.
# Everything else, including any new file or directory, stays out by default.
/*                  export-ignore
/assets             -export-ignore
/includes           -export-ignore
/templates          -export-ignore
/trust-optimize.php -export-ignore
/uninstall.php      -export-ignore
/readme.txt         -export-ignore
/README.md          -export-ignore
/CHANGELOG.md       -export-ignore
/LICENSE            -export-ignore
/composer.json      -export-ignore
/composer.lock      -export-ignore
